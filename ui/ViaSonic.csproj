<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ViaSonic</RootNamespace>
    <AssemblyName>ViaSonic</AssemblyName>
    <!-- 版本号只改这里，安装包从 exe 里读取 -->
    <Version>2.4.1</Version>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- 裁剪掉没用到的框架代码（169MB → 约 90MB）。NAudio 走 COM，必须保留内置 COM 互操作 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8618;CA1416</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ViaSonic.ico</ApplicationIcon>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- 语音输入：本地识别（SenseVoice）和说话检测（Silero VAD） -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <!-- 手机输入：电脑上显示的二维码 -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 原生调用的结构体靠反射读取字段，不能被裁剪 -->
    <TrimmerRootAssembly Include="sherpa-onnx" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Phone\phone.html" LogicalName="phone.html" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ViaSonic.Lang" Static="true" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ViaSonic.Tests" />
  </ItemGroup>
  <!-- Windows App SDK 自带 88 种语言的控件文字（.mui），软件界面只有中英文，只保留这两种；其他系统语言会退回英文 -->
  <Target Name="TrimWinUILanguages" AfterTargets="Publish">
    <ItemGroup>
      <_ExtraMui Include="$(PublishDir)*\*.mui" Exclude="$(PublishDir)zh-CN\*.mui;$(PublishDir)en-us\*.mui" />
    </ItemGroup>
    <RemoveDir Directories="@(_ExtraMui-&gt;'%(RootDir)%(Directory)'-&gt;Distinct())" />
  </Target>
</Project>
