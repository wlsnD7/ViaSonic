<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaSonic.Pages.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ViaSonic.Markup"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:c="using:ViaSonic.Controls">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <Grid>
                <TextBlock Text="{l:T Text='音频'}" Style="{StaticResource PageTitle}" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click" Background="Transparent" BorderBrush="Transparent"
                        ToolTipService.ToolTip="{l:T Text='刷新设备'}" AutomationProperties.Name="{l:T Text='刷新设备'}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <InfoBar x:Name="CableBar" Severity="Warning" IsClosable="False" IsOpen="False" Title="{l:T Text='未检测到虚拟麦克风'}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="{l:T Text='下载'}" NavigateUri="https://vb-audio.com/Cable/" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- 虚拟麦克风 -->
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='虚拟麦克风'}" Tip="{l:T Text='通过虚拟麦克风播放声音。游戏里的麦克风选 CABLE Output；用 Voicemeeter 时选 Voicemeeter Out B1，并在 Voicemeeter 里打开这一路的 B1。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE720;" /></tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="MicOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Toggle_Changed" Tag="mic_enabled" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='设备'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="MicDevice" Width="340" SelectionChanged="Device_Changed" Tag="mic_device" />
                            <TextBlock x:Name="MicVolText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="MicVol" Width="140" Minimum="0" Maximum="150" StepFrequency="5" ValueChanged="Volume_Changed" Tag="mic_volume"
                                    AutomationProperties.Name="{l:T Text='音量'}" />
                        </StackPanel>
                    </tk:SettingsCard>
                </StackPanel>
            </Border>

            <!-- 接入虚拟麦克风的声音：麦克风、应用 -->
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='麦克风直通'}" Tip="{l:T Text='把麦克风的声音接入虚拟麦克风。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE1D6;" /></tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="PassOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Toggle_Changed" Tag="mic_passthrough" />
                    </tk:SettingsCard>
                    <InfoBar x:Name="PassBar" Severity="Warning" IsClosable="False" IsOpen="False" Title="{l:T Text='需要先打开虚拟麦克风'}" CornerRadius="0" BorderThickness="0" />
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='设备'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="PassDevice" Width="340" SelectionChanged="Device_Changed" Tag="passthrough_device" />
                            <TextBlock x:Name="PassVolText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="PassVol" Width="140" Minimum="0" Maximum="150" StepFrequency="5" ValueChanged="Volume_Changed" Tag="passthrough_volume"
                                    AutomationProperties.Name="{l:T Text='音量'}" />
                        </StackPanel>
                    </tk:SettingsCard>
                </StackPanel>
            </Border>

            <!-- 监听：朗读和音效、麦克风共用一个监听设备 -->
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='监听'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F6;" /></tk:SettingsCard.HeaderIcon>
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='设备'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="MonDevice" Width="340" SelectionChanged="Device_Changed" Tag="monitor_device" />
                            <TextBlock x:Name="MonVolText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="MonVol" Width="140" Minimum="0" Maximum="150" StepFrequency="5" ValueChanged="Volume_Changed" Tag="monitor_volume"
                                    AutomationProperties.Name="{l:T Text='音量'}" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='朗读和音效'}" Tip="{l:T Text='在监听设备里听到朗读的语音和播放的音效。'}" />
                        </tk:SettingsCard.Header>
                        <ToggleSwitch x:Name="MonOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Toggle_Changed" Tag="monitor_enabled" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='麦克风'}" Tip="{l:T Text='开着变声器时听到的是变声后的声音。'}" />
                        </tk:SettingsCard.Header>
                        <ToggleSwitch x:Name="PassMonOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Toggle_Changed" Tag="mic_monitor" />
                    </tk:SettingsCard>
                </StackPanel>
            </Border>

            <tk:SettingsExpander x:Name="AppPanel" IsExpanded="True">
                <tk:SettingsExpander.Header>
                    <c:InfoHeader Text="{l:T Text='应用声音'}" Tip="{l:T Text='把选中应用的声音接入虚拟麦克风。'}" />
                </tk:SettingsExpander.Header>
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D6;" /></tk:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="AppOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Toggle_Changed" Tag="app_audio" />
                <tk:SettingsExpander.ItemsHeader>
                    <StackPanel>
                        <InfoBar x:Name="AppBar" Severity="Warning" IsClosable="False" IsOpen="False" Title="{l:T Text='需要先打开虚拟麦克风'}" CornerRadius="0" BorderThickness="0" />
                        <InfoBar x:Name="AppUnsupportedBar" Severity="Error" IsClosable="False" IsOpen="False" Title="{l:T Text='当前 Windows 版本不支持'}" CornerRadius="0" BorderThickness="0" />
                    </StackPanel>
                </tk:SettingsExpander.ItemsHeader>
                <!-- 应用列表和「添加应用」在代码里生成（AudioPage.Apps.cs） -->
            </tk:SettingsExpander>

            <TextBlock Text="{l:T Text='播放'}" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='连续发送'}" Tip="{l:T Text='打断：立刻播放新语音；排队＝播放完上一条再播新语音。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FD;" /></tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="PlayMode" MinWidth="160" SelectionChanged="PlayMode_Changed">
                            <ComboBoxItem Content="{l:T Text='打断'}" Tag="interrupt" />
                            <ComboBoxItem Content="{l:T Text='排队'}" Tag="queue" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='前置静音 (ms)'}" Tip="{l:T Text='在语音开头添加一段静音，软件内「语音激活」检测声音需要一点时间。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></tk:SettingsCard.HeaderIcon>
                        <NumberBox x:Name="LeadSilence" Minimum="0" Maximum="1000" SmallChange="20" LargeChange="100"
                                   SpinButtonPlacementMode="Inline" MinWidth="160" ValueChanged="Number_Changed" Tag="lead_silence_ms" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='按键说话'}" Tip="{l:T Text='开启后，语音播放期间自动按住这个键，播完松开。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE962;" /></tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="PttOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Toggle_Changed" Tag="ptt_enabled" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='按键'}">
                        <c:HotkeyButton x:Name="PttKey" SingleKey="True" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='提前按下 (ms)'}" Tip="{l:T Text='按键说话会等待一段时间再开始播放。'}" />
                        </tk:SettingsCard.Header>
                        <NumberBox x:Name="PttDelay" Minimum="0" Maximum="1000" SmallChange="50" LargeChange="100"
                                   SpinButtonPlacementMode="Inline" MinWidth="160" ValueChanged="Number_Changed" Tag="ptt_delay_ms" />
                    </tk:SettingsCard>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Group}">
                <tk:SettingsCard Style="{StaticResource Row}">
                    <tk:SettingsCard.Header>
                        <c:InfoHeader Text="{l:T Text='随机音色'}" Tip="{l:T Text='每次朗读随机换一个引擎和音色，常用语不变。'}" />
                    </tk:SettingsCard.Header>
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B1;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="RandomOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Toggle_Changed" Tag="random_voice" />
                </tk:SettingsCard>
            </Border>
        </StackPanel>
    </c:PageColumn>
    </ScrollViewer>
</Page>
