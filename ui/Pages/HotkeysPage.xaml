<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaSonic.Pages.HotkeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ViaSonic.Markup"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:c="using:ViaSonic.Controls">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="{l:T Text='设置'}" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='语言'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></tk:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="LangBox" MinWidth="160" SelectionChanged="LangBox_Changed">
                            <ComboBoxItem Content="简体中文" Tag="zh" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </tk:SettingsCard>
                </StackPanel>
            </Border>

            <InfoBar x:Name="ErrBar" Severity="Warning" IsClosable="False" IsOpen="False" Title="{l:T Text='快捷键冲突'}" />

            <TextBlock Text="{l:T Text='快捷键'}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='打开/关闭输入框'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE70F;" /></tk:SettingsCard.HeaderIcon>
                        <c:HotkeyButton x:Name="HkInput" Tag="input" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='聚焦输入框'}" Tip="{l:T Text='按快捷键聚焦于输入框，只在输入框开启时启用。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AC;" /></tk:SettingsCard.HeaderIcon>
                        <c:HotkeyButton x:Name="HkFocus" Tag="focus" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='停止'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE71A;" /></tk:SettingsCard.HeaderIcon>
                        <c:HotkeyButton x:Name="HkStop" Tag="stop" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='重复上一句'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8EE;" /></tk:SettingsCard.HeaderIcon>
                        <c:HotkeyButton x:Name="HkRepeat" Tag="repeat" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='打开/关闭按键说话'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE962;" /></tk:SettingsCard.HeaderIcon>
                        <c:HotkeyButton x:Name="HkPtt" Tag="ptt" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='播放/暂停音乐'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE768;" /></tk:SettingsCard.HeaderIcon>
                        <c:HotkeyButton x:Name="HkPlaylist" Tag="playlist" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='下一首'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE893;" /></tk:SettingsCard.HeaderIcon>
                        <c:HotkeyButton x:Name="HkNext" Tag="next" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='暂停快捷键'}" Tip="{l:T Text='暂时停用除「打开/关闭输入框」「聚焦输入框」以外的所有快捷键。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE769;" /></tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Paused" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Paused_Toggled" />
                    </tk:SettingsCard>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:T Text='输入框'}" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='播完后收起'}" Tip="{l:T Text='开启：语音播完后输入框自动收起。关闭：输入框持久存在，再按一次快捷键收起。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE73F;" /></tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="HideAfter" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Overlay_Toggled" Tag="hide_after_send" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='归还焦点'}" Tip="{l:T Text='发送语音后，以及输入框收起时，自动切回呼出前的窗口。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="RestoreFocus" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="Overlay_Toggled" Tag="restore_focus" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='不透明度'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="OpacityText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="OpacitySlider" Width="220" Minimum="20" Maximum="100" StepFrequency="5" ValueChanged="Opacity_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='宽度'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE740;" /></tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="WidthText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="WidthSlider" Width="220" Minimum="10" Maximum="90" StepFrequency="1" ValueChanged="Width_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='水平位置'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE784;" /></tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="XText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="XSlider" Width="220" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="X_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='底部距离'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74B;" /></tk:SettingsCard.HeaderIcon>
                        <NumberBox x:Name="Bottom" Minimum="0" Maximum="2000" SmallChange="20" LargeChange="100"
                                   SpinButtonPlacementMode="Inline" MinWidth="160" ValueChanged="Bottom_Changed" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='重置位置'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72C;" /></tk:SettingsCard.HeaderIcon>
                        <Button Content="{l:T Text='重置'}" Click="ResetPosition_Click" />
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='预览'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B3;" /></tk:SettingsCard.HeaderIcon>
                        <Button Content="{l:T Text='显示'}" Click="Preview_Click" />
                    </tk:SettingsCard>
                </StackPanel>
            </Border>

            <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Margin="0,16,0,0" Title="{l:T Text='游戏请使用无边框窗口模式'}" />
        </StackPanel>
    </c:PageColumn>
    </ScrollViewer>
</Page>
