<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaTTS.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="关于" Style="{StaticResource PageTitle}" />

            <tk:SettingsExpander x:Name="AppCard" Header="ViaTTS">
                <tk:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/ViaTTS.png" />
                </tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="GPT-SoVITS">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/RVC-Boss/GPT-SoVITS" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Edge TTS">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/rany2/edge-tts" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="虚拟麦克风">
                        <HyperlinkButton Content="官网" NavigateUri="https://vb-audio.com/Cable/" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="常见问题">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE897;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="对方听不到我说话"
                                     Description="游戏或语音软件里的麦克风要选择CABLE Output，另外检查「音频」页的虚拟麦克风是不是输出到CABLE Input。" />
                    <tk:SettingsCard Header="快捷键没反应"
                                     Description="可能被其他软件占用，如果游戏以管理员身份运行，ViaTTS 也要以管理员身份运行，不然快捷键等对游戏都不起作用。" />
                    <tk:SettingsCard Header="弹出输入框时游戏最小化了"
                                     Description="把游戏改成无边框窗口模式。" />
                    <tk:SettingsCard Header="Edge TTS 合成失败"
                                     Description="Edge TTS需要联网。开着代理的话，试试关掉或者换个节点。" />
                    <tk:SettingsCard Header="GPT-SoVITS 用不了"
                                     Description="只支持 Nvidia显卡。第一次加载要 30 秒左右，属于正常现象。显存不够时，在「设备」里改成 CPU，不过速度会变慢。报错详情可以在「关于」页的日志里看到。" />
                    <tk:SettingsCard Header="卸载后怎么删配置"
                                     Description="配置、常用语和日志都在 %LOCALAPPDATA%\ViaTTS，卸载时会保留，需手动删除。" />
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="免责声明">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7BA;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard ContentAlignment="Left">
                        <TextBlock TextWrapping="Wrap" LineHeight="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="• ViaTTS 是免费的开源软件。" /><LineBreak />
                            <Run Text="• Edge TTS 用的是微软 Edge「大声朗读」的接口。用 Edge TTS 时，你输入的文字会发送到微软的服务器。" /><LineBreak />
                            <Run Text="• ViaTTS 不收集、不上传任何数据，启动时会访问 GitHub 检查新版本。" /><LineBreak />
                            <Run Text="• ViaTTS 会监听全局快捷键，还会模拟按下按键说话的键。个别游戏的反作弊系统可能会因此有反应，请自行判断。因此造成的封号等后果由使用者承担。" /><LineBreak />
                            <Run Text="• 使用 GPT-SoVITS 模型时，不要用来冒充他人、诈骗或骚扰，由此产生的责任由使用者承担。模型的版权归原作者。" />
                        </TextBlock>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsCard Header="数据文件夹" x:Name="FolderCard">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="打开" Click="OpenFolder_Click" />
            </tk:SettingsCard>

            <TextBlock Text="日志" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource Card}" Padding="0" Height="320">
                <ScrollViewer x:Name="LogScroll" Padding="16,12">
                    <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
