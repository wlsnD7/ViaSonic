<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaSonic.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ViaSonic.Markup"
    xmlns:c="using:ViaSonic.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="{l:T Text='关于'}" Style="{StaticResource PageTitle}" />

            <tk:SettingsExpander x:Name="AppCard" Header="ViaSonic">
                <tk:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/ViaSonic.png" />
                </tk:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="UpdateRing" IsActive="False" Width="20" Height="20" />
                    <HyperlinkButton x:Name="UpdateLink" Content="{l:T Text='下载'}" Visibility="Collapsed" />
                    <Button x:Name="UpdateButton" Content="{l:T Text='检查更新'}" Click="CheckUpdate_Click" />
                </StackPanel>
                <tk:SettingsExpander.Items>
                    <!-- 软件介绍，放在外链上面 -->
                    <tk:SettingsCard ContentAlignment="Left">
                        <TextBlock Text="{l:T Text='实时文本转语音、变声器（含 RVC）、常用语和音效，以及音乐播放器。通过虚拟麦克风输出声音。'}" TextWrapping="Wrap" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="GPT-SoVITS">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/RVC-Boss/GPT-SoVITS" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="RVC">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/RVC-Project/Retrieval-based-Voice-Conversion-WebUI" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Edge TTS">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/rany2/edge-tts" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='虚拟麦克风'}">
                        <HyperlinkButton Content="{l:T Text='官网'}" NavigateUri="https://vb-audio.com/Cable/" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="{l:T Text='常见问题'}">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE897;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="{l:T Text='对方听不到我说话'}"
                                     Description="{l:T Text='游戏或语音软件里的麦克风要选 CABLE Output，「音频」页的虚拟麦克风要输出到 CABLE Input。用 Voicemeeter 时，虚拟麦克风选 Voicemeeter Input，在 Voicemeeter 里打开这一路的 B1，游戏里的麦克风选 Voicemeeter Out B1。'}" />
                    <tk:SettingsCard Header="{l:T Text='快捷键没反应'}"
                                     Description="{l:T Text='可能被其他软件占用，如果游戏以管理员身份运行，ViaSonic 也要以管理员身份运行，不然快捷键等对游戏都不起作用。'}" />
                    <tk:SettingsCard Header="{l:T Text='弹出输入框时游戏最小化了'}"
                                     Description="{l:T Text='有些游戏一失去焦点就会最小化，即使是无边框窗口。可以在游戏设置里关掉「失去焦点时最小化」之类的选项，或者改成窗口模式。'}" />
                    <tk:SettingsCard Header="{l:T Text='Edge TTS 合成失败'}"
                                     Description="{l:T Text='Edge TTS需要联网。开着代理的话，试试关掉或者换个节点。'}" />
                    <tk:SettingsCard Header="{l:T Text='GPT-SoVITS 用不了'}"
                                     Description="{l:T Text='只支持 NVIDIA 显卡。第一次加载要 30 秒左右，属于正常现象。显存不够时，在「设备」里改成 CPU，不过速度会变慢。报错详情可以在「关于」页的日志里看到。'}" />
                    <tk:SettingsCard Header="{l:T Text='变声没有效果'}"
                                     Description="{l:T Text='在「变声」页打开变声器并勾选「麦克风」，再确认「音频」页的麦克风直通选对了麦克风。语音输入开着时，麦克风直通会自动关掉。'}" />
                    <tk:SettingsCard Header="{l:T Text='换了音色后会重新合成吗'}"
                                     Description="{l:T Text='「重复上一句」和常用语在没改引擎、音色、语速时，直接播放上次合成的声音；改了其中任何一项，就用新的设置重新合成。免费引擎切换后会在后台把常用语预先合成好，收费服务第一次用到时才合成。缓存只在内存里，重启软件后清空。'}" />
                    <tk:SettingsCard Header="{l:T Text='语音输入没反应'}"
                                     Description="{l:T Text='用「按住快捷键」时，要先在「快捷键」页设置「按住语音输入」。用本地模型要先点「下载」。识别用的是「音频」页麦克风直通选的麦克风。'}" />
                    <tk:SettingsCard Header="{l:T Text='语音输入识别不准'}"
                                     Description="{l:T Text='说话时离麦克风近一点，尽量吐字清晰。'}" />
                    <tk:SettingsCard Header="{l:T Text='手机打不开页面'}"
                                     Description="{l:T Text='确认手机和电脑在同一个网络下。在卡片上点「允许」。电脑的 IP 变了以后，旧链接会打不开，需要重新扫码。'}" />
                    <tk:SettingsCard Header="{l:T Text='AI 变声（RVC）用不了'}"
                                     Description="{l:T Text='需要 NVIDIA 显卡和 2026 年 7 月以后的 RVC 整合包。第一次加载要半分钟左右，期间麦克风没有声音。显卡跟不上时，点 ⚙ 把采样长度调大。'}" />
                    <tk:SettingsCard Header="{l:T Text='提示 API Key 无效'}"
                                     Description="{l:T Text='检查 Key 是否复制完整、有没有过期，以及选的地域和 Key 是否一致。'}" />
                    <tk:SettingsCard Header="{l:T Text='耳机里听到自己的声音'}"
                                     Description="{l:T Text='「音频」页监听里的「麦克风」会把你的声音放进耳机，不需要时关掉。'}" />
                    <tk:SettingsCard Header="{l:T Text='装了 VB-Cable 或 Voicemeeter 后自己听不到声音'}"
                                     Description="{l:T Text='安装时系统的默认播放设备可能被改成了 CABLE Input 或 Voicemeeter Input。在 Windows 设置的「声音」里把输出改回耳机或扬声器。已经打开的软件（比如浏览器）要重启，或者在「音量合成器」里把它的输出设备改回来。'}" />
                    <tk:SettingsCard Header="{l:T Text='卸载后怎么删配置'}"
                                     Description="{l:T Text='配置、常用语、日志和语音识别模型都在 %LOCALAPPDATA%\ViaSonic，卸载时会保留，需手动删除。'}" />
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander Header="{l:T Text='免责声明'}">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7BA;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard ContentAlignment="Left">
                        <TextBlock TextWrapping="Wrap" LineHeight="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{l:T Text='• ViaSonic 是免费的开源软件。'}" /><LineBreak />
                            <Run Text="{l:T Text='• 使用联网语音引擎（Edge TTS、Azure、Fish Audio、豆包、阿里云百炼、MiniMax、讯飞、ElevenLabs、自定义接口）时，你输入的文字会发送到对应服务商的服务器，收费服务按各家的价格计费。语音输入用在线识别（Azure、阿里云百炼、讯飞、自定义接口）时，录下的声音会发送到对应服务商。'}" /><LineBreak />
                            <Run Text="{l:T Text='• ViaSonic 不收集、不上传任何数据，API Key 只加密保存在本机。启动时会访问 GitHub 和 Gitee 检查新版本。'}" /><LineBreak />
                            <Run Text="{l:T Text='• ViaSonic 会监听全局快捷键，还会模拟按下按键说话的键。个别游戏的反作弊系统可能会因此有反应，请自行判断，因此造成的封号等后果由使用者承担。'}" /><LineBreak />
                            <Run Text="{l:T Text='• 使用 GPT-SoVITS 或 RVC 模型时，不要用来冒充他人、诈骗或骚扰，由此产生的责任由使用者承担。模型的版权归原作者。'}" />
                        </TextBlock>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsCard Header="{l:T Text='数据文件夹'}" x:Name="FolderCard">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsCard.HeaderIcon>
                <Button Content="{l:T Text='打开'}" Click="OpenFolder_Click" />
            </tk:SettingsCard>

            <TextBlock Text="{l:T Text='日志'}" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource Card}" Padding="0" Height="320">
                <ScrollViewer x:Name="LogScroll" Padding="16,12">
                    <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </c:PageColumn>
    </ScrollViewer>
</Page>
