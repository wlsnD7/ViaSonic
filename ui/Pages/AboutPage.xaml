<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaTTS.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="36,28,36,24" RowSpacing="4" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="关于" Style="{StaticResource PageTitle}" />

        <tk:SettingsExpander Grid.Row="1" Header="ViaTTS">
            <tk:SettingsExpander.HeaderIcon>
                <ImageIcon Source="ms-appx:///Assets/ViaTTS.png" />
            </tk:SettingsExpander.HeaderIcon>
            <tk:SettingsExpander.Items>
                <tk:SettingsCard Header="GPT-SoVITS">
                    <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/RVC-Boss/GPT-SoVITS" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Edge TTS">
                    <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/rany2/edge-tts" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="虚拟麦克风">
                    <HyperlinkButton Content="官网" NavigateUri="https://vb-audio.com/Cable/" />
                </tk:SettingsCard>
            </tk:SettingsExpander.Items>
        </tk:SettingsExpander>

        <tk:SettingsCard Grid.Row="2" Header="数据文件夹" x:Name="FolderCard">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsCard.HeaderIcon>
            <Button Content="打开" Click="OpenFolder_Click" />
        </tk:SettingsCard>

        <TextBlock Grid.Row="3" Text="日志" Style="{StaticResource SectionHeader}" />

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="LogScroll" Padding="16,12">
                <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
