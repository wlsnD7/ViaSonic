<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaSonic.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ViaSonic.Markup"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:c="using:ViaSonic.Controls">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="{l:T Text='朗读'}" Style="{StaticResource PageTitle}" />

            <InfoBar x:Name="UpdateBar" Severity="Informational" IsClosable="True" IsOpen="False"
                     Closed="UpdateBar_Closed">
                <InfoBar.ActionButton>
                    <HyperlinkButton x:Name="UpdateLink" Content="{l:T Text='下载'}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="CableBar" Severity="Warning" IsClosable="True" IsOpen="False"
                     Title="{l:T Text='未检测到虚拟麦克风'}" Message="{l:T Text='需要安装 VB-Cable 或 Voicemeeter，其他人才能听到声音。'}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="{l:T Text='下载 VB-Cable'}" NavigateUri="https://vb-audio.com/Cable/" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="GsvBar" Severity="Warning" IsClosable="False" IsOpen="False">
                <InfoBar.ActionButton>
                    <HyperlinkButton x:Name="GsvLink" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBox x:Name="TestBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" KeyDown="TestBox_KeyDown" />
                    <Grid>
                    <TextBlock x:Name="SynthText" Style="{StaticResource HintText}" VerticalAlignment="Center" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Click="Overlay_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE765;" FontSize="14" />
                                <TextBlock Text="{l:T Text='输入框'}" />
                            </StackPanel>
                        </Button>
                        <Button Click="Stop_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock Text="{l:T Text='停止'}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Speak_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="{l:T Text='朗读'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}" Header="{l:T Text='引擎'}">
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D6;" /></tk:SettingsCard.HeaderIcon>
                        <tk:SettingsCard.Description>
                            <TextBlock x:Name="StatusText" />
                        </tk:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="LoadRing" IsActive="False" Width="20" Height="20" />
                            <!-- GPT-SoVITS 的设备和整合包目录：装好后基本不动，收在这里（和 AI 变声的 ⚙ 一样） -->
                            <Button x:Name="GsvGear" ToolTipService.ToolTip="{l:T Text='高级'}" AutomationProperties.Name="{l:T Text='高级'}">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Grid Width="400" ColumnSpacing="16" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <c:InfoHeader Text="{l:T Text='设备'}" Tip="{l:T Text='CUDA 使用 NVIDIA 显卡推理，CPU在没有 NVIDIA 显卡时使用。修改后需重启。'}" />
                                            <ComboBox x:Name="GsvDevice" Grid.Column="1" MinWidth="160" SelectionChanged="GsvDevice_Changed">
                                                <ComboBoxItem Content="CUDA" Tag="cuda" />
                                                <ComboBoxItem Content="CPU" Tag="cpu" />
                                            </ComboBox>
                                            <TextBlock Grid.Row="1" Text="{l:T Text='切换引擎后保持加载'}" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="GsvKeep" Grid.Row="1" Grid.Column="1" MinWidth="0" HorizontalAlignment="Right"
                                                          OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="GsvKeep_Toggled"
                                                          AutomationProperties.Name="{l:T Text='切换引擎后保持加载'}" />
                                            <c:InfoHeader Grid.Row="2" Grid.ColumnSpan="2" Text="{l:T Text='GPT-SoVITS 目录'}" Tip="{l:T Text='GPT-SoVITS 整合包所在的文件夹。'}" />
                                            <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="GsvBox" PlaceholderText="{l:T Text='自动'}" LostFocus="GsvHome_LostFocus" />
                                                <Button Grid.Column="1" Content="{l:T Text='浏览'}" Click="BrowseGsv_Click" />
                                            </Grid>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <!-- 引擎会自动加载，只有加载失败后才出现「重试」 -->
                            <Button x:Name="LoadButton" Content="{l:T Text='重试'}" Click="Load_Click" Visibility="Collapsed" />
                            <ComboBox x:Name="EngineBox" MinWidth="220" SelectionChanged="Engine_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <!-- GPT-SoVITS -->
                    <StackPanel x:Name="GsvPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='模型'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="ModelBox" MinWidth="220" SelectionChanged="Model_Changed" />
                                <Button Click="AddModel_Click" ToolTipService.ToolTip="{l:T Text='添加模型'}">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                                <Button x:Name="DelModelButton" Click="DelModel_Click" ToolTipService.ToolTip="{l:T Text='删除模型'}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="GsvSpeedText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                                <Slider x:Name="GsvSpeed" Width="220" Minimum="0.6" Maximum="1.6" StepFrequency="0.05" ValueChanged="GsvSpeed_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语言'}">
                            <ComboBox x:Name="GsvLang" MinWidth="160" SelectionChanged="GsvLang_Changed" />
                        </tk:SettingsCard>
                    </StackPanel>


                    <!-- Edge -->
                    <StackPanel x:Name="EdgePanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='音色'}">
                            <ComboBox x:Name="EdgeVoice" MinWidth="260" SelectionChanged="EdgeVoice_Changed" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="EdgeRateText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                                <Slider x:Name="EdgeRate" Width="220" Minimum="-50" Maximum="100" StepFrequency="5" ValueChanged="EdgeRate_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- Windows 系统语音 -->
                    <StackPanel x:Name="SapiPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='音色'}">
                            <ComboBox x:Name="SapiVoice" MinWidth="320" SelectionChanged="SapiVoice_Changed" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="SapiRateText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                                <Slider x:Name="SapiRate" Width="220" Minimum="-10" Maximum="10" StepFrequency="1" ValueChanged="SapiRate_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- Azure 语音 -->
                    <StackPanel x:Name="AzurePanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="API Key" Tip="{l:T Text='在 Azure 创建「语音服务」资源后获得，每月 50 万字符免费。'}" />
                            </tk:SettingsCard.Header>
                            <PasswordBox x:Name="AzureKey" Width="340" Tag="azure_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='区域'}">
                            <ComboBox x:Name="AzureRegion" Width="220" IsEditable="True" PlaceholderText="{l:T Text='如 eastasia'}"
                                      SelectionChanged="AzureRegion_Changed" TextSubmitted="AzureRegion_Submitted" LostFocus="AzureRegion_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语言'}">
                            <ComboBox x:Name="AzureLang" MinWidth="260" SelectionChanged="AzureLang_Changed" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='音色'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="AzureVoice" MinWidth="260" SelectionChanged="AzureVoice_Changed" />
                                <Button Click="RefreshVoices_Click" Tag="azure" ToolTipService.ToolTip="{l:T Text='刷新音色'}" AutomationProperties.Name="{l:T Text='刷新音色'}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='风格'}">
                            <ComboBox x:Name="AzureStyle" MinWidth="160" SelectionChanged="AzureStyle_Changed" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="AzureRateText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                                <Slider x:Name="AzureRate" Width="220" Minimum="-50" Maximum="100" StepFrequency="5" Tag="azure_rate" ValueChanged="Rate_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- Fish Audio -->
                    <StackPanel x:Name="FishPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Key">
                            <PasswordBox x:Name="FishKey" Width="340" Tag="fish_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="{l:T Text='音色'}" Tip="{l:T Text='列表里是你创建的音色和添加的音色。'}" />
                            </tk:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="FishVoice" Width="260" Tag="fish_voice" SelectionChanged="Voice_Changed" />
                                <Button Click="AddVoice_Click" Tag="fish" ToolTipService.ToolTip="{l:T Text='添加音色'}" AutomationProperties.Name="{l:T Text='添加音色'}">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                                <Button x:Name="FishDelVoice" Click="RemoveVoice_Click" Tag="fish" ToolTipService.ToolTip="{l:T Text='删除音色'}" AutomationProperties.Name="{l:T Text='删除音色'}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                                <Button Click="RefreshVoices_Click" Tag="fish" ToolTipService.ToolTip="{l:T Text='刷新音色'}" AutomationProperties.Name="{l:T Text='刷新音色'}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="FishSpeedText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                                <Slider x:Name="FishSpeed" Width="220" Minimum="0.5" Maximum="2" StepFrequency="0.05" Tag="fish_speed" ValueChanged="Rate_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- 豆包语音 -->
                    <StackPanel x:Name="DoubaoPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="API Key" Tip="{l:T Text='在豆包语音控制台的「API Key 管理」获取。'}" />
                            </tk:SettingsCard.Header>
                            <PasswordBox x:Name="DoubaoKey" Width="340" Tag="doubao_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='模型'}">
                            <ComboBox x:Name="DoubaoModel" MinWidth="260" Tag="doubao_model" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="{l:T Text='豆包语音合成 2.0'}" Tag="2.0" />
                                <ComboBoxItem Content="{l:T Text='豆包语音合成 1.0'}" Tag="1.0" />
                                <ComboBoxItem Content="{l:T Text='豆包声音复刻 2.0'}" Tag="icl2" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <!-- 选声音复刻 2.0 时，标题旁的问号说明去哪里拿复刻音色的 ID（DoubaoCloneTip） -->
                            <tk:SettingsCard.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DoubaoVoiceTitle" Text="{l:T Text='音色'}" VerticalAlignment="Center" />
                                    <c:InfoHeader x:Name="DoubaoCloneTip" Text="{l:T Text='音色'}" Visibility="Collapsed"
                                                  Tip="{l:T Text='在火山引擎控制台的声音复刻里复刻好声音，把 S_ 开头的音色 ID 点 ＋ 添加进来。'}" />
                                </StackPanel>
                            </tk:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="DoubaoVoice" Width="260" Tag="doubao_voice" SelectionChanged="Voice_Changed" />
                                <Button Click="AddVoice_Click" Tag="doubao" ToolTipService.ToolTip="{l:T Text='添加音色'}" AutomationProperties.Name="{l:T Text='添加音色'}">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                                <Button x:Name="DoubaoDelVoice" Click="RemoveVoice_Click" Tag="doubao" ToolTipService.ToolTip="{l:T Text='删除音色'}" AutomationProperties.Name="{l:T Text='删除音色'}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="DoubaoRateText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                                <Slider x:Name="DoubaoRate" Width="220" Minimum="-50" Maximum="100" StepFrequency="5" Tag="doubao_rate" ValueChanged="Rate_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- 阿里云百炼 -->
                    <StackPanel x:Name="BailianPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Key">
                            <PasswordBox x:Name="BailianKey" Width="340" Tag="bailian_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='地域'}">
                            <ComboBox x:Name="BailianRegion" MinWidth="160" Tag="bailian_region" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="{l:T Text='中国大陆'}" Tag="cn" />
                                <ComboBoxItem Content="{l:T Text='国际'}" Tag="intl" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='模型'}">
                            <ComboBox x:Name="BailianModel" MinWidth="160" Tag="bailian_model" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="Qwen3-TTS" Tag="qwen" />
                                <ComboBoxItem Content="CosyVoice" Tag="cosy" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='音色'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="BailianVoice" Width="260" Tag="bailian_voice" SelectionChanged="Voice_Changed" />
                                <Button Click="AddVoice_Click" Tag="bailian" ToolTipService.ToolTip="{l:T Text='添加音色'}" AutomationProperties.Name="{l:T Text='添加音色'}">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                                <Button x:Name="BailianDelVoice" Click="RemoveVoice_Click" Tag="bailian" ToolTipService.ToolTip="{l:T Text='删除音色'}" AutomationProperties.Name="{l:T Text='删除音色'}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" x:Name="BailianSpeedCard" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="BailianSpeedText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                                <Slider x:Name="BailianSpeed" Width="220" Minimum="0.5" Maximum="2" StepFrequency="0.05" Tag="bailian_speed" ValueChanged="Rate_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- MiniMax -->
                    <StackPanel x:Name="MiniMaxPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Key">
                            <PasswordBox x:Name="MiniMaxKey" Width="340" Tag="minimax_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='地域'}">
                            <ComboBox x:Name="MiniMaxRegion" MinWidth="160" Tag="minimax_region" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="{l:T Text='中国大陆'}" Tag="cn" />
                                <ComboBoxItem Content="{l:T Text='国际'}" Tag="intl" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='模型'}">
                            <ComboBox x:Name="MiniMaxModel" MinWidth="200" Tag="minimax_model" SelectionChanged="Choice_Changed" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="{l:T Text='音色'}" Tip="{l:T Text='列表里包含你复刻的音色。'}" />
                            </tk:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="MiniMaxVoice" MinWidth="260" Tag="minimax_voice" SelectionChanged="Choice_Changed" />
                                <Button Click="RefreshVoices_Click" Tag="minimax" ToolTipService.ToolTip="{l:T Text='刷新音色'}" AutomationProperties.Name="{l:T Text='刷新音色'}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="MiniMaxSpeedText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                                <Slider x:Name="MiniMaxSpeed" Width="220" Minimum="0.5" Maximum="2" StepFrequency="0.05" Tag="minimax_speed" ValueChanged="Rate_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- 讯飞语音：APPID、Key、Secret 和语音输入共用 -->
                    <StackPanel x:Name="XunfeiPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="APPID" Tip="{l:T Text='在讯飞开放平台的控制台创建应用后获得，API Key 和 API Secret 在同一个页面。'}" />
                            </tk:SettingsCard.Header>
                            <TextBox x:Name="XunfeiAppId" Width="340" Tag="xunfei_appid" TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Key">
                            <PasswordBox x:Name="XunfeiKey" Width="340" Tag="xunfei_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Secret">
                            <PasswordBox x:Name="XunfeiSecret" Width="340" Tag="xunfei_secret" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="{l:T Text='音色'}" Tip="{l:T Text='在讯飞控制台添加发音人后，把它的参数值（vcn）点 ＋ 添加进来。'}" />
                            </tk:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="XunfeiVoice" Width="260" Tag="xunfei_voice" SelectionChanged="Voice_Changed" />
                                <Button Click="AddVoice_Click" Tag="xunfei" ToolTipService.ToolTip="{l:T Text='添加音色'}" AutomationProperties.Name="{l:T Text='添加音色'}">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                </Button>
                                <Button x:Name="XunfeiDelVoice" Click="RemoveVoice_Click" Tag="xunfei" ToolTipService.ToolTip="{l:T Text='删除音色'}" AutomationProperties.Name="{l:T Text='删除音色'}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语速'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="XunfeiRateText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                                <Slider x:Name="XunfeiRate" Width="220" Minimum="-50" Maximum="50" StepFrequency="5" Tag="xunfei_rate" ValueChanged="Rate_Changed" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- 自定义接口 -->
                    <StackPanel x:Name="CustomPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='请求方式'}">
                            <ComboBox x:Name="CustomMethod" MinWidth="120" Tag="custom_method" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="GET" Tag="GET" />
                                <ComboBoxItem Content="POST" Tag="POST" />
                            </ComboBox>
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader x:Name="CustomUrlHeader" Text="{l:T Text='地址'}" />
                            </tk:SettingsCard.Header>
                            <TextBox x:Name="CustomUrl" Width="340" Tag="custom_url" TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="{l:T Text='请求头'}" Tip="{l:T Text='每行一个，例如 Authorization: Bearer xxx'}" />
                            </tk:SettingsCard.Header>
                            <TextBox x:Name="CustomHeaders" Width="340" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" Tag="custom_headers"
                                     TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" x:Name="CustomBodyCard">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader x:Name="CustomBodyHeader" Text="{l:T Text='请求体'}" />
                            </tk:SettingsCard.Header>
                            <TextBox x:Name="CustomBody" Width="340" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" Tag="custom_body"
                                     TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                        </tk:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </Border>

            <tk:SettingsExpander x:Name="ModelPanel" Header="{l:T Text='模型文件'}">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="{l:T Text='名称'}">
                        <TextBox x:Name="ModelName" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="name" />
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='GPT 权重'}" Tip="{l:T Text='训练得到的 .ckpt 文件（GPT_weights 目录下）。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ModelGpt" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="gpt" />
                            <Button Content="{l:T Text='浏览'}" Click="BrowseModelFile_Click" Tag="gpt" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='SoVITS 权重'}" Tip="{l:T Text='训练得到的 .pth 文件（SoVITS_weights 目录下）。版本会自动识别。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ModelSovits" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="sovits" />
                            <Button Content="{l:T Text='浏览'}" Click="BrowseModelFile_Click" Tag="sovits" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='参考音频'}" Tip="{l:T Text='3~10 秒的人声片段，决定音色和语气。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ModelRef" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="ref" />
                            <Button Content="{l:T Text='浏览'}" Click="BrowseModelFile_Click" Tag="ref" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='参考文本'}" Tip="{l:T Text='参考音频里说的文本，需要与音频完全一致。'}" />
                        </tk:SettingsCard.Header>
                        <TextBox x:Name="ModelRefText" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="ref_text" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='参考语言'}">
                        <ComboBox x:Name="ModelRefLang" MinWidth="160" SelectionChanged="ModelRefLang_Changed" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- 语音输入：识别说的话再朗读。和麦克风直通只能开一个 -->
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='语音输入'}" Tip="{l:T Text='把你说的话识别成文字，再用当前音色朗读。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE720;" /></tk:SettingsCard.HeaderIcon>
                        <tk:SettingsCard.Description>
                            <TextBlock x:Name="SttStatus" TextWrapping="Wrap" />
                        </tk:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="SttRing" IsActive="False" Width="20" Height="20" />
                            <ToggleSwitch x:Name="SttOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="SttOn_Toggled"
                                          AutomationProperties.Name="{l:T Text='语音输入'}" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='识别'}">
                        <ComboBox x:Name="SttEngine" MinWidth="220" Tag="stt_engine" SelectionChanged="SttChoice_Changed">
                            <ComboBoxItem Content="{l:T Text='本地模型'}" Tag="local" />
                            <ComboBoxItem Content="{l:T Text='Azure 语音'}" Tag="azure" />
                            <ComboBoxItem Content="{l:T Text='阿里云百炼'}" Tag="bailian" />
                            <ComboBoxItem Content="{l:T Text='讯飞语音'}" Tag="xunfei" />
                            <ComboBoxItem Content="{l:T Text='自定义接口'}" Tag="custom" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <Rectangle Style="{StaticResource Divider}" />
                    <tk:SettingsCard Style="{StaticResource SubRow}">
                        <!-- 选「持续检测」时标题旁出现问号说明 -->
                        <tk:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SttModeTitle" Text="{l:T Text='方式'}" VerticalAlignment="Center" />
                                <c:InfoHeader x:Name="SttModeTip" Text="{l:T Text='方式'}" Visibility="Collapsed"
                                              Tip="{l:T Text='说完一句自动朗读，朗读时暂停识别。'}" />
                            </StackPanel>
                        </tk:SettingsCard.Header>
                        <ComboBox x:Name="SttMode" MinWidth="220" Tag="stt_mode" SelectionChanged="SttChoice_Changed">
                            <ComboBoxItem Content="{l:T Text='按住快捷键'}" Tag="hold" />
                            <ComboBoxItem Content="{l:T Text='持续检测'}" Tag="auto" />
                        </ComboBox>
                    </tk:SettingsCard>

                    <!-- 本地模型：没下载时显示下载按钮，下好后这一行收起 -->
                    <StackPanel x:Name="SttLocalPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='模型'}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="SttModelText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
                                <ProgressBar x:Name="SttModelBar" Width="160" Maximum="1" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Button x:Name="SttDownload" Content="{l:T Text='下载（约 230 MB）'}" Click="SttDownload_Click" />
                            </StackPanel>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- Azure：Key 和区域与朗读引擎共用 -->
                    <StackPanel x:Name="SttAzurePanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Key">
                            <PasswordBox x:Name="SttAzureKey" Width="340" Tag="azure_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='区域'}">
                            <ComboBox x:Name="SttAzureRegion" Width="220" IsEditable="True" PlaceholderText="{l:T Text='如 eastasia'}"
                                      SelectionChanged="AzureRegion_Changed" TextSubmitted="AzureRegion_Submitted" LostFocus="AzureRegion_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语言'}">
                            <ComboBox x:Name="SttAzureLang" MinWidth="160" SelectionChanged="SttAzureLang_Changed" />
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- 阿里云百炼：Key 和地域与朗读引擎共用 -->
                    <StackPanel x:Name="SttBailianPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Key">
                            <PasswordBox x:Name="SttBailianKey" Width="340" Tag="bailian_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='地域'}">
                            <ComboBox x:Name="SttBailianRegion" MinWidth="160" Tag="bailian_region" SelectionChanged="Choice_Changed">
                                <ComboBoxItem Content="{l:T Text='中国大陆'}" Tag="cn" />
                                <ComboBoxItem Content="{l:T Text='国际'}" Tag="intl" />
                            </ComboBox>
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- 讯飞语音：APPID、Key、Secret 与朗读引擎共用 -->
                    <StackPanel x:Name="SttXunfeiPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="APPID" Tip="{l:T Text='在讯飞开放平台的控制台创建应用后获得，API Key 和 API Secret 在同一个页面。'}" />
                            </tk:SettingsCard.Header>
                            <TextBox x:Name="SttXunfeiAppId" Width="340" Tag="xunfei_appid" TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Key">
                            <PasswordBox x:Name="SttXunfeiKey" Width="340" Tag="xunfei_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Secret">
                            <PasswordBox x:Name="SttXunfeiSecret" Width="340" Tag="xunfei_secret" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='语言'}">
                            <ComboBox x:Name="SttXunfeiLang" MinWidth="160" SelectionChanged="SttXunfeiLang_Changed" />
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- 自定义接口：OpenAI 格式 -->
                    <StackPanel x:Name="SttCustomPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}">
                            <tk:SettingsCard.Header>
                                <c:InfoHeader Text="{l:T Text='接口地址'}" Tip="{l:T Text='兼容 OpenAI 的语音转文字接口（/v1/audio/transcriptions）。'}" />
                            </tk:SettingsCard.Header>
                            <TextBox x:Name="SttCustomUrl" Width="340" Tag="stt_custom_url" TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="API Key">
                            <PasswordBox x:Name="SttCustomKey" Width="340" Tag="stt_custom_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                        </tk:SettingsCard>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='模型'}">
                            <TextBox x:Name="SttCustomModel" Width="340" Tag="stt_custom_model" TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                        </tk:SettingsCard>
                    </StackPanel>

                    <StackPanel x:Name="SttLastPanel">
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='上一句'}">
                            <TextBlock x:Name="SttLast" TextWrapping="Wrap" MaxWidth="340" IsTextSelectionEnabled="True" />
                        </tk:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 手机输入：手机浏览器打开局域网网页，打的字用电脑朗读 -->
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <tk:SettingsCard Style="{StaticResource Row}">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='手机输入'}" Tip="{l:T Text='在手机上打字，在电脑上读出来。'}" />
                        </tk:SettingsCard.Header>
                        <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8EA;" /></tk:SettingsCard.HeaderIcon>
                        <tk:SettingsCard.Description>
                            <TextBlock x:Name="PhoneStatus" TextWrapping="Wrap" />
                        </tk:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="PhoneRing" IsActive="False" Width="20" Height="20" />
                            <Button x:Name="PhoneAllow" Content="{l:T Text='允许'}" Visibility="Collapsed" Click="PhoneAllow_Click" />
                            <ToggleSwitch x:Name="PhoneOn" OnContent="{l:T Text='开'}" OffContent="{l:T Text='关'}" Toggled="PhoneOn_Toggled"
                                          AutomationProperties.Name="{l:T Text='手机输入'}" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <StackPanel x:Name="PhonePanel" Visibility="Collapsed">
                        <StackPanel x:Name="PhoneAddrPanel">
                            <Rectangle Style="{StaticResource Divider}" />
                            <!-- 二维码在左，和上面的标题对齐；链接和按钮在右边 -->
                            <Grid Padding="58,14,16,14" ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="PhoneQr" Width="144" Height="144" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{l:T Text='地址'}" />
                                    <TextBlock x:Name="PhoneUrl" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="{l:T Text='更换链接'}" Margin="0,6,0,0" Click="PhoneNewLink_Click"
                                            ToolTipService.ToolTip="{l:T Text='旧链接会失效，需要重新扫码。'}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="PhoneNetPanel" Visibility="Collapsed">
                            <Rectangle Style="{StaticResource Divider}" />
                            <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='网络'}">
                                <ComboBox x:Name="PhoneNet" MinWidth="220" SelectionChanged="PhoneNet_Changed" />
                            </tk:SettingsCard>
                        </StackPanel>
                        <Rectangle Style="{StaticResource Divider}" />
                        <tk:SettingsCard Style="{StaticResource SubRow}" Header="{l:T Text='端口'}">
                            <NumberBox x:Name="PhonePort" Minimum="1024" Maximum="65535" SmallChange="1" LargeChange="10"
                                       SpinButtonPlacementMode="Inline" MinWidth="160" ValueChanged="PhonePort_Changed" />
                        </tk:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </c:PageColumn>
    </ScrollViewer>
</Page>
