<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaTTS.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ViaTTS.Markup"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:c="using:ViaTTS.Controls">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PageStack}">
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,24">
                <Image Source="ms-appx:///Assets/ViaTTS.png" Width="44" Height="44" VerticalAlignment="Center" />
                <TextBlock Text="ViaTTS" Style="{StaticResource TitleLargeTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <InfoBar x:Name="UpdateBar" Severity="Informational" IsClosable="True" IsOpen="False" Margin="0,0,0,4"
                     Closed="UpdateBar_Closed">
                <InfoBar.ActionButton>
                    <HyperlinkButton x:Name="UpdateLink" Content="{l:T Text='下载'}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="CableBar" Severity="Warning" IsClosable="True" IsOpen="False" Margin="0,0,0,4"
                     Title="{l:T Text='未检测到虚拟麦克风'}" Message="{l:T Text='需要安装 VB-Cable，游戏里的人才能听到。'}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="{l:T Text='下载 VB-Cable'}" NavigateUri="https://vb-audio.com/Cable/" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="GsvBar" Severity="Warning" IsClosable="False" IsOpen="False" Margin="0,0,0,4">
                <InfoBar.ActionButton>
                    <HyperlinkButton x:Name="GsvLink" />
                </InfoBar.ActionButton>
            </InfoBar>

            <tk:SettingsCard Header="{l:T Text='状态'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressRing x:Name="LoadRing" IsActive="False" Width="20" Height="20" />
                    <Button x:Name="LoadButton" Content="{l:T Text='加载'}" Click="Load_Click" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard Header="{l:T Text='引擎'}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D6;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="EngineBox" MinWidth="260" SelectionChanged="Engine_Changed" />
            </tk:SettingsCard>

            <!-- GPT-SoVITS -->
            <tk:SettingsExpander x:Name="GsvPanel" Header="GPT-SoVITS" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE950;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="{l:T Text='模型'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ModelBox" MinWidth="220" SelectionChanged="Model_Changed" />
                            <Button Click="AddModel_Click" ToolTipService.ToolTip="{l:T Text='添加模型'}">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button x:Name="DelModelButton" Click="DelModel_Click" ToolTipService.ToolTip="{l:T Text='删除模型'}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语速'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="GsvSpeedText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="GsvSpeed" Width="220" Minimum="0.6" Maximum="1.6" StepFrequency="0.05" ValueChanged="GsvSpeed_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语言'}">
                        <ComboBox x:Name="GsvLang" MinWidth="160" SelectionChanged="GsvLang_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='设备'}" Tip="{l:T Text='CUDA 使用 NVIDIA 显卡推理，CPU在没有 NVIDIA 显卡时使用。修改后需重启。'}" />
                        </tk:SettingsCard.Header>
                        <ComboBox x:Name="GsvDevice" MinWidth="160" SelectionChanged="GsvDevice_Changed">
                            <ComboBoxItem Content="CUDA" Tag="cuda" />
                            <ComboBoxItem Content="CPU" Tag="cpu" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='GPT-SoVITS 目录'}" Tip="{l:T Text='GPT-SoVITS 整合包所在的文件夹。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="GsvBox" Width="340" PlaceholderText="{l:T Text='自动'}" LostFocus="GsvHome_LostFocus" />
                            <Button Content="{l:T Text='浏览'}" Click="BrowseGsv_Click" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsExpander x:Name="ModelPanel" Header="{l:T Text='模型文件'}">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="{l:T Text='名称'}">
                        <TextBox x:Name="ModelName" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="name" />
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='GPT 权重'}" Tip="{l:T Text='训练得到的 .ckpt 文件（GPT_weights 目录下）。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ModelGpt" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="gpt" />
                            <Button Content="{l:T Text='浏览'}" Click="BrowseModelFile_Click" Tag="gpt" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='SoVITS 权重'}" Tip="{l:T Text='训练得到的 .pth 文件（SoVITS_weights 目录下）。版本会自动识别。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ModelSovits" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="sovits" />
                            <Button Content="{l:T Text='浏览'}" Click="BrowseModelFile_Click" Tag="sovits" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='参考音频'}" Tip="{l:T Text='3~10 秒的人声片段，决定音色和语气。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ModelRef" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="ref" />
                            <Button Content="{l:T Text='浏览'}" Click="BrowseModelFile_Click" Tag="ref" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='参考文本'}" Tip="{l:T Text='参考音频里说的文本，需要与音频完全一致。'}" />
                        </tk:SettingsCard.Header>
                        <TextBox x:Name="ModelRefText" Width="340" LostFocus="ModelField_LostFocus" TextChanged="ModelField_TextChanged" KeyDown="ModelField_KeyDown" Tag="ref_text" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='参考语言'}">
                        <ComboBox x:Name="ModelRefLang" MinWidth="160" SelectionChanged="ModelRefLang_Changed" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Edge -->
            <tk:SettingsExpander x:Name="EdgePanel" Header="Edge TTS" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE774;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="{l:T Text='音色'}">
                        <ComboBox x:Name="EdgeVoice" MinWidth="260" SelectionChanged="EdgeVoice_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语速'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="EdgeRateText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                            <Slider x:Name="EdgeRate" Width="220" Minimum="-50" Maximum="100" StepFrequency="5" ValueChanged="EdgeRate_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Windows 系统语音 -->
            <tk:SettingsExpander x:Name="SapiPanel" Header="{l:T Text='系统语音'}" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7F8;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="{l:T Text='音色'}">
                        <ComboBox x:Name="SapiVoice" MinWidth="320" SelectionChanged="SapiVoice_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语速'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="SapiRateText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="SapiRate" Width="220" Minimum="-10" Maximum="10" StepFrequency="1" ValueChanged="SapiRate_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Azure 语音 -->
            <tk:SettingsExpander x:Name="AzurePanel" Header="{l:T Text='Azure 语音'}" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE753;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="API Key" Tip="{l:T Text='在 Azure 创建「语音服务」资源后获得，每月 50 万字符免费。'}" />
                        </tk:SettingsCard.Header>
                        <PasswordBox x:Name="AzureKey" Width="340" Tag="azure_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='区域'}">
                        <ComboBox x:Name="AzureRegion" Width="220" IsEditable="True" PlaceholderText="{l:T Text='如 eastasia'}"
                                  SelectionChanged="AzureRegion_Changed" TextSubmitted="AzureRegion_Submitted" LostFocus="AzureRegion_LostFocus" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语言'}">
                        <ComboBox x:Name="AzureLang" MinWidth="260" SelectionChanged="AzureLang_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='音色'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="AzureVoice" MinWidth="260" SelectionChanged="AzureVoice_Changed" />
                            <Button Click="RefreshVoices_Click" Tag="azure" ToolTipService.ToolTip="{l:T Text='刷新音色'}" AutomationProperties.Name="{l:T Text='刷新音色'}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='风格'}">
                        <ComboBox x:Name="AzureStyle" MinWidth="160" SelectionChanged="AzureStyle_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语速'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="AzureRateText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                            <Slider x:Name="AzureRate" Width="220" Minimum="-50" Maximum="100" StepFrequency="5" Tag="azure_rate" ValueChanged="Rate_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- Fish Audio -->
            <tk:SettingsExpander x:Name="FishPanel" Header="Fish Audio" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE753;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="API Key">
                        <PasswordBox x:Name="FishKey" Width="340" Tag="fish_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='音色'}" Tip="{l:T Text='列表里是你创建的音色和添加的音色。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="FishVoice" Width="260" Tag="fish_voice" SelectionChanged="Voice_Changed" />
                            <Button Click="AddVoice_Click" Tag="fish" ToolTipService.ToolTip="{l:T Text='添加音色'}" AutomationProperties.Name="{l:T Text='添加音色'}">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button x:Name="FishDelVoice" Click="RemoveVoice_Click" Tag="fish" ToolTipService.ToolTip="{l:T Text='删除音色'}" AutomationProperties.Name="{l:T Text='删除音色'}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                            <Button Click="RefreshVoices_Click" Tag="fish" ToolTipService.ToolTip="{l:T Text='刷新音色'}" AutomationProperties.Name="{l:T Text='刷新音色'}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语速'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="FishSpeedText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="FishSpeed" Width="220" Minimum="0.5" Maximum="2" StepFrequency="0.05" Tag="fish_speed" ValueChanged="Rate_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- 豆包语音 -->
            <tk:SettingsExpander x:Name="DoubaoPanel" Header="{l:T Text='豆包语音'}" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE753;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="API Key" Tip="{l:T Text='在豆包语音控制台的「API Key 管理」获取。'}" />
                        </tk:SettingsCard.Header>
                        <PasswordBox x:Name="DoubaoKey" Width="340" Tag="doubao_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='模型'}">
                        <ComboBox x:Name="DoubaoModel" MinWidth="260" Tag="doubao_model" SelectionChanged="Choice_Changed">
                            <ComboBoxItem Content="{l:T Text='豆包语音合成 2.0'}" Tag="2.0" />
                            <ComboBoxItem Content="{l:T Text='豆包语音合成 1.0'}" Tag="1.0" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='音色'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="DoubaoVoice" Width="260" Tag="doubao_voice" SelectionChanged="Voice_Changed" />
                            <Button Click="AddVoice_Click" Tag="doubao" ToolTipService.ToolTip="{l:T Text='添加音色'}" AutomationProperties.Name="{l:T Text='添加音色'}">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button x:Name="DoubaoDelVoice" Click="RemoveVoice_Click" Tag="doubao" ToolTipService.ToolTip="{l:T Text='删除音色'}" AutomationProperties.Name="{l:T Text='删除音色'}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语速'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="DoubaoRateText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right" />
                            <Slider x:Name="DoubaoRate" Width="220" Minimum="-50" Maximum="100" StepFrequency="5" Tag="doubao_rate" ValueChanged="Rate_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- 阿里云百炼 -->
            <tk:SettingsExpander x:Name="BailianPanel" Header="{l:T Text='阿里云百炼'}" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE753;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="API Key">
                        <PasswordBox x:Name="BailianKey" Width="340" Tag="bailian_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='地域'}">
                        <ComboBox x:Name="BailianRegion" MinWidth="160" Tag="bailian_region" SelectionChanged="Choice_Changed">
                            <ComboBoxItem Content="{l:T Text='中国大陆'}" Tag="cn" />
                            <ComboBoxItem Content="{l:T Text='国际'}" Tag="intl" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='模型'}">
                        <ComboBox x:Name="BailianModel" MinWidth="160" Tag="bailian_model" SelectionChanged="Choice_Changed">
                            <ComboBoxItem Content="Qwen3-TTS" Tag="qwen" />
                            <ComboBoxItem Content="CosyVoice" Tag="cosy" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='音色'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="BailianVoice" Width="260" Tag="bailian_voice" SelectionChanged="Voice_Changed" />
                            <Button Click="AddVoice_Click" Tag="bailian" ToolTipService.ToolTip="{l:T Text='添加音色'}" AutomationProperties.Name="{l:T Text='添加音色'}">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button x:Name="BailianDelVoice" Click="RemoveVoice_Click" Tag="bailian" ToolTipService.ToolTip="{l:T Text='删除音色'}" AutomationProperties.Name="{l:T Text='删除音色'}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="BailianSpeedCard" Header="{l:T Text='语速'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="BailianSpeedText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="BailianSpeed" Width="220" Minimum="0.5" Maximum="2" StepFrequency="0.05" Tag="bailian_speed" ValueChanged="Rate_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- MiniMax -->
            <tk:SettingsExpander x:Name="MiniMaxPanel" Header="MiniMax" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE753;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="API Key">
                        <PasswordBox x:Name="MiniMaxKey" Width="340" Tag="minimax_key" PasswordChanged="Key_Changed" LostFocus="Key_LostFocus" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='地域'}">
                        <ComboBox x:Name="MiniMaxRegion" MinWidth="160" Tag="minimax_region" SelectionChanged="Choice_Changed">
                            <ComboBoxItem Content="{l:T Text='中国大陆'}" Tag="cn" />
                            <ComboBoxItem Content="{l:T Text='国际'}" Tag="intl" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='模型'}">
                        <ComboBox x:Name="MiniMaxModel" MinWidth="200" Tag="minimax_model" SelectionChanged="Choice_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='音色'}" Tip="{l:T Text='列表里包含你复刻的音色。'}" />
                        </tk:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="MiniMaxVoice" MinWidth="260" Tag="minimax_voice" SelectionChanged="Choice_Changed" />
                            <Button Click="RefreshVoices_Click" Tag="minimax" ToolTipService.ToolTip="{l:T Text='刷新音色'}" AutomationProperties.Name="{l:T Text='刷新音色'}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="{l:T Text='语速'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="MiniMaxSpeedText" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                            <Slider x:Name="MiniMaxSpeed" Width="220" Minimum="0.5" Maximum="2" StepFrequency="0.05" Tag="minimax_speed" ValueChanged="Rate_Changed" />
                        </StackPanel>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- 自定义接口 -->
            <tk:SettingsExpander x:Name="CustomPanel" Header="{l:T Text='自定义接口'}" IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE968;" /></tk:SettingsExpander.HeaderIcon>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="{l:T Text='请求方式'}">
                        <ComboBox x:Name="CustomMethod" MinWidth="120" Tag="custom_method" SelectionChanged="Choice_Changed">
                            <ComboBoxItem Content="GET" Tag="GET" />
                            <ComboBoxItem Content="POST" Tag="POST" />
                        </ComboBox>
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader x:Name="CustomUrlHeader" Text="{l:T Text='地址'}" />
                        </tk:SettingsCard.Header>
                        <TextBox x:Name="CustomUrl" Width="340" Tag="custom_url" TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                    </tk:SettingsCard>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <c:InfoHeader Text="{l:T Text='请求头'}" Tip="{l:T Text='每行一个，例如 Authorization: Bearer xxx'}" />
                        </tk:SettingsCard.Header>
                        <TextBox x:Name="CustomHeaders" Width="340" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" Tag="custom_headers"
                                 TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="CustomBodyCard">
                        <tk:SettingsCard.Header>
                            <c:InfoHeader x:Name="CustomBodyHeader" Text="{l:T Text='请求体'}" />
                        </tk:SettingsCard.Header>
                        <TextBox x:Name="CustomBody" Width="340" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" Tag="custom_body"
                                 TextChanged="Text_Changed" LostFocus="Text_LostFocus" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock Text="{l:T Text='试听'}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBox x:Name="TestBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" KeyDown="TestBox_KeyDown" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Click="Overlay_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE765;" FontSize="14" />
                                <TextBlock Text="{l:T Text='输入框'}" />
                            </StackPanel>
                        </Button>
                        <Button Click="Stop_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock Text="{l:T Text='停止'}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="Speak_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="{l:T Text='朗读'}" />
                            </StackPanel>
