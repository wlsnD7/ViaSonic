<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaTTS.Pages.PhrasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ViaTTS.Markup">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="{l:T Text='常用语'}" Style="{StaticResource PageTitle}" />

            <Grid Margin="0,0,0,12">
                <Button Style="{StaticResource AccentButtonStyle}" Click="Add_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="{l:T Text='添加'}" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="ErrBar" Severity="Warning" IsClosable="False" IsOpen="False" Title="{l:T Text='快捷键冲突'}" Margin="0,0,0,8" />

            <StackPanel x:Name="List" Spacing="8" />

            <TextBlock x:Name="Empty" Text="{l:T Text='暂无常用语'}" Style="{StaticResource HintText}" Margin="0,24,0,0"
                       HorizontalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
