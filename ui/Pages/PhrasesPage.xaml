<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ViaTTS.Pages.PhrasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ViaTTS.Markup"
    AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Text="{l:T Text='常用语与音效'}" Style="{StaticResource PageTitle}" />

            <Grid Margin="0,0,0,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{l:T Text='添加'}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="{l:T Text='添加'}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="{l:T Text='文字'}" Click="AddText_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="{l:T Text='音频'}" Click="AddAudio_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D6;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="1" Click="StopAll_Click" AutomationProperties.Name="{l:T Text='停止全部'}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="{l:T Text='停止全部'}" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{l:T Text='音频音量'}" VerticalAlignment="Center" />
                    <Slider x:Name="SoundVol" AutomationProperties.Name="{l:T Text='音频音量'}" Width="160" Minimum="0" Maximum="150" StepFrequency="5" VerticalAlignment="Center"
                            ValueChanged="SoundVol_Changed" />
                    <TextBlock x:Name="SoundVolText" VerticalAlignment="Center" MinWidth="40" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrBar" Severity="Warning" IsClosable="False" IsOpen="False" Title="{l:T Text='快捷键冲突'}" Margin="0,0,0,8" />

            <StackPanel x:Name="List" Spacing="6" />

            <TextBlock x:Name="Empty" Text="{l:T Text='添加常用语或音频文件'}" Style="{StaticResource HintText}" Margin="0,24,0,0"
                       HorizontalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
