<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ViaSonic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:c="using:ViaSonic.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="SettingsCardSpacing">4</x:Double>

            <Style x:Key="PageScroll" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollMode" Value="Disabled" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- 页面内容放在 PageColumn 里（最宽 960、居中） -->
            <Style x:Key="PageStack" TargetType="StackPanel">
                <Setter Property="Padding" Value="32,20,32,32" />
                <Setter Property="Spacing" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,12,0,-4" />
            </Style>

            <!-- 一组设置：一张卡片里放几行，行之间用分隔线 -->
            <Style x:Key="Group" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>

            <Style x:Key="Row" TargetType="tk:SettingsCard">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="16,10,16,10" />
                <Setter Property="MinHeight" Value="56" />
            </Style>

            <!-- 组里的子项：和带图标那一行的标题对齐 -->
            <Style x:Key="SubRow" TargetType="tk:SettingsCard" BasedOn="{StaticResource Row}">
                <Setter Property="Padding" Value="58,6,16,6" />
                <Setter Property="MinHeight" Value="52" />
            </Style>

            <Style x:Key="Divider" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- 调音旋钮（Controls/Knob.cs）：底圈、轨道弧、数值弧、指针 -->
            <Style TargetType="c:Knob">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="c:Knob">
                            <Grid Background="Transparent">
                                <Ellipse Margin="8" Fill="{ThemeResource ControlFillColorDefaultBrush}"
                                         Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                                <Path x:Name="Track" Stroke="{ThemeResource ControlStrongStrokeColorDisabledBrush}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path x:Name="Fill" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Rectangle x:Name="Pointer" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Margin="0,12,0,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
